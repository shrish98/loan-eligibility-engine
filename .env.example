# Copy to .env and fill in. .env is git-ignored; never commit real secrets.
# Values marked (auto) are written for you by the scripts in ./scripts.

# --- AWS ---
AWS_REGION=ap-south-1

# --- Database the workflows use (Amazon RDS after `serverless deploy`) ---
DB_HOST=                       # (auto) RDS endpoint, written by scripts/init-rds.sh
DB_PORT=5432
DB_NAME=loan_engine
DB_USER=loan_admin
DB_PASSWORD=                   # (auto) generated by scripts/setup-aws-params.sh
DB_SSL=require                 # use "disable" with the local-db profile

# --- n8n ---
# Any long random string. Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
N8N_ENCRYPTION_KEY=change-me
N8N_WEBHOOK_URL=http://localhost:5678/
N8N_WEBHOOK_SECRET=            # (auto) shared secret the Lambda sends to Workflow B's webhook

# --- LLM (Google Gemini; free key from https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
LLM_DELAY_SECONDS=4            # pause between LLM calls to stay inside free-tier rate limits

# --- Email (Amazon SES) ---
SES_FROM_EMAIL=you@gmail.com   # must be verified in SES
# Every email is redirected to these test inboxes (never to the CSV's addresses).
# In the SES sandbox each one must be verified (scripts/setup-ses.sh does this).
TEST_INBOX_ALIASES=you+one@gmail.com,you+two@gmail.com,you+three@gmail.com
MAX_EMAILS_PER_RUN=5
SES_ACCESS_KEY_ID=             # (auto) keys of the send-only IAM user, written by scripts/setup-ses.sh
SES_SECRET_ACCESS_KEY=

# --- Optional local Postgres (docker compose --profile local-db up -d) ---
POSTGRES_DB=loan_engine
POSTGRES_USER=loan_admin
POSTGRES_PASSWORD=change-me
LOCAL_PG_PORT=55432

# --- n8n login (created by scripts/n8n-bootstrap.sh on first run) ---
N8N_OWNER_EMAIL=admin@loan-engine.local
N8N_OWNER_PASSWORD=            # (auto)
