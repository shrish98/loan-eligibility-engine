# Copy to .env and fill in. .env is git-ignored; never commit real secrets.

# --- Postgres (local container) ---
POSTGRES_DB=loan_engine
POSTGRES_USER=loan_admin
POSTGRES_PASSWORD=change-me

# --- n8n ---
# Any long random string. Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
N8N_ENCRYPTION_KEY=change-me
N8N_WEBHOOK_URL=http://localhost:5678/
